# Copy to .env and fill in. .env is gitignored — never commit it.
# Supabase dashboard → Project Settings → API (Data API URL + API Keys)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "anon" key or the newer "publishable" key (sb_publishable_...) — safe to make public
SUPABASE_ANON_KEY=
# "service_role" key or the newer "secret" key (sb_secret_...) — SECRET, tests only
SUPABASE_SERVICE_KEY=
# From: select family_token from settings;  (run in the SQL Editor after schema.sql) — SECRET
FAMILY_TOKEN=
